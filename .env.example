# Copy to .env and change these before deploying.
ADMIN_PASSWORD=change-me-to-something-long
# Long random string. Signs admin login cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Set to true when the site is served over HTTPS (it should be, in production).
COOKIE_SECURE=false
# Set to false to start with an empty database instead of 90 days of demo activity.
SEED_DEMO=true
# Host port to expose.
PORT=3000

# --- Optional: permanent database (needed on Vercel if you want data to survive restarts) ---
# Create a free database at https://turso.tech, then paste its URL and token here (or in Vercel's settings).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
